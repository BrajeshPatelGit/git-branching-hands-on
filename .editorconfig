root = true                         # Stop searching for .editorconfig in parent directories

[*]                                 # Apply to all files
charset = utf-8                     # Use UTF-8 encoding for all files
end_of_line = lf                    # Enforce LF line endings (matches .gitattributes)
indent_style = space                # Use spaces for indentation
indent_size = 2                     # Default indent size of 2 spaces
trim_trailing_whitespace = true     # Remove trailing whitespace on save
insert_final_newline = true         # Ensure files end with a newline

[*.py]                              # Python files override
indent_size = 4                     # PEP 8 requires 4-space indentation

[*.md]                              # Markdown files override
trim_trailing_whitespace = false    # Preserve trailing spaces (used for line breaks in Markdown)
